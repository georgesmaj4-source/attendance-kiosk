# Local development needs NOTHING here — it uses a file database automatically.
#
# For CLOUD hosting (Render + Turso), set these in the Render dashboard
# (Environment tab). Do NOT commit real values.

# Your Turso database URL, e.g. libsql://attendance-yourorg.turso.io
DATABASE_URL=

# A Turso database auth token
DATABASE_AUTH_TOKEN=

# Optional: initial admin PIN applied on the very first startup (defaults to 1234).
# Changing it later is done in the admin console, not here.
ADMIN_PIN=
